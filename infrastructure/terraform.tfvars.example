# Example terraform.tfvars file
# Copy this to terraform.tfvars and fill in your values

# Required variables
domain_name = "epaper.yourdomain.com"  # Replace with your actual domain

# Optional variables - uncomment and set if needed
# hosted_zone_id         = "Z1234567890ABCD"        # Specify zone ID (auto-discovered if empty)
# key_name               = "your-aws-key-pair-name" # SSH key (optional - SSM Session Manager available)
# inlets_token           = ""                       # Leave empty to auto-generate secure token
# generate_client_config = true                     # Generate .env.inlets file for client setup
# inlets_upstream        = "http://epaper-display:80" # Client upstream target (customize if needed)

# Optional variables (uncomment and modify as needed)
# aws_region      = "us-east-1"
# instance_type   = "t3.micro"
# allowed_ssh_cidrs = ["1.2.3.4/32"]  # Replace with your IP range for security

# tags = {
#   Project     = "ePaper"
#   Environment = "production"
#   ManagedBy   = "terraform"
#   Owner       = "your-name"
# }
# Generate secure Chisel authentication if not provided
resource "random_password" "chisel_auth" {
  count   = var.chisel_auth == "" ? 1 : 0
  length  = 64
  special = false
}

# Create user data script for Chisel server setup
locals {
  # Use provided auth or generate one
  actual_chisel_auth = var.chisel_auth != "" ? var.chisel_auth : random_password.chisel_auth[0].result
  
  user_data = base64encode(templatefile("${path.module}/templates/chisel-server-init.sh", {
    chisel_auth = local.actual_chisel_auth
    CHISEL_AUTH = local.actual_chisel_auth
    domain_name = var.domain_name
    enable_certbot_staging = var.enable_certbot_staging
    letsencrypt_bucket = aws_s3_bucket.letsencrypt.bucket
    CERT_ARCHIVE = "${var.domain_name}.tar.gz"
    letsencrypt_enabled = var.use_letsencrypt_s3
  }))
}

# EC2 Instance for Chisel Server
resource "aws_instance" "chisel_server" {
  ami                    = data.aws_ami.amazon_linux.id
  instance_type          = var.instance_type
  key_name               = var.key_name
  vpc_security_group_ids = [aws_security_group.chisel_server.id]
  
  # Let AWS assign a public IP automatically (default VPC behavior)
  associate_public_ip_address = true
  iam_instance_profile   = aws_iam_instance_profile.chisel_server.name
  
  user_data = local.user_data

  tags = merge(var.tags, {
    Name = "epaper-chisel-server"
  })

  # Ensure we have a new instance if user data changes
  user_data_replace_on_change = true
}

# Elastic IP for stable public IP
resource "aws_eip" "chisel_server" {
  instance = aws_instance.chisel_server.id
  domain   = "vpc"

  tags = merge(var.tags, {
    Name = "epaper-chisel-server-eip"
  })
}

# Generate Chisel client configuration (optional)
resource "local_file" "chisel_client_env" {
  count = var.generate_client_config ? 1 : 0
  
  filename = "${path.module}/.env.chisel"
  content = <<-EOF
# Chisel Client Configuration
# Generated by Terraform
#
# This file contains sensitive information - do not commit to version control

CHISEL_SERVER=https://${var.domain_name}:8080
CHISEL_AUTH=${local.actual_chisel_auth}
CHISEL_UPSTREAM=${var.chisel_upstream}
EOF
  
  file_permission = "0600"  # Secure permissions for sensitive file
}
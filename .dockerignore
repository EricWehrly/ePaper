.vscode/
.idea/
*.swp
*.swo
*~

# Git and version control
.git/
.gitignore

# Docker files (no need to copy into image except entrypoint)
Dockerfile
.dockerignore
docker-compose.yml

# Documentation and project files
README.md
docs/
*.md

# Build artifacts and temporary files
.DS_Store
Thumbs.db
*.tmp
*.bak

